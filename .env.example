# Variable NAMES only. Never a real value in this file.
#
# Copy to .env for local use. .env is ignored; .env.example is tracked, and
# the negation in .gitignore exists so that this file, and only this file,
# survives the .env.* rule.
#
# Nothing here is read from a file by the code. alpha/config.py reads the
# process environment, so a .env is something your shell or runner loads, not
# something this system parses.

# Nasdaq Data Link, for US equity history.
NDL_API_KEY=
